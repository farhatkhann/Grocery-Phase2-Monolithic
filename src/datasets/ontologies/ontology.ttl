@prefix base: <http://example.org/monolith#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

base:businessRole a owl:DatatypeProperty ;
    rdfs:label "businessRole" ;
    rdfs:domain base:Function ;
    rdfs:range xsd:string .

base:fn_CreateProduct_6 a base:Function ;
    rdfs:label "CreateProduct" ;
    base:businessRole "Create"^^xsd:string ;
    base:httpMethod "POST"^^xsd:string ;
    base:intent "Create"^^xsd:string ;
    base:relatesTo base:Product ;
    base:route "/product/create"^^xsd:string ;
    base:sourceFile "src\\api\\products.js"^^xsd:string .

base:fn_GetProductDescription_8 a base:Function ;
    rdfs:label "GetProductDescription" ;
    base:businessRole "Fetch"^^xsd:string ;
    base:httpMethod "GET"^^xsd:string ;
    base:intent "Fetch"^^xsd:string ;
    base:relatesTo base:GenericEntity ;
    base:route "/:id"^^xsd:string ;
    base:sourceFile "src\\api\\products.js"^^xsd:string .

