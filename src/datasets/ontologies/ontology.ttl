base:httpMethod a owl:DatatypeProperty ;
    rdfs:label "httpMethod" ;
    rdfs:domain base:Function ;
    rdfs:range xsd:string .

base:intent a owl:DatatypeProperty ;
    rdfs:label "intent" ;
    rdfs:domain base:Function ;
    rdfs:range xsd:string .

base:relatesTo a owl:ObjectProperty ;
    rdfs:label "relatesTo" ;
    rdfs:domain base:Function ;
    rdfs:range owl:Thing .

base:route a owl:DatatypeProperty ;
    rdfs:label "route" ;
