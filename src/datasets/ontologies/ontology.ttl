    rdfs:range xsd:string .

base:Product a owl:Class ;
    rdfs:label "Product" .

base:Order a owl:Class ;
    rdfs:label "Order" .

base:Wishlist a owl:Class ;
    rdfs:label "Wishlist" .

base:Cart a owl:Class ;
